# --- Gemini Configuration ---
# Required: Obtain your API key from Google AI Studio or Google Cloud Console
GEMINI_API_KEY=

# --- Cloud TTS Proxy Configuration ---
# Endpoint for the locally running TTS proxy (from cloud-tts/main.py)
# TTS_API_ENDPOINT=http://arshsensei.duckdns.org/tts/generate_audio/
# Default voice to use if not specified otherwise
# DEFAULT_TTS_VOICE=en-US-BrianNeural

# --- Audio Generator API Configuration ---
# URL for the external audio generation API service
AUDIO_GENERATOR_API_URL=http://localhost:8000/

# --- File Paths (relative to edu_video_generator directory) ---
# Directory for final video outputs
OUTPUT_DIR=output/
# Directory for intermediate generated assets (audio, diagrams, manim scenes)
ASSETS_DIR=assets/

# --- Optional: External Tool Paths ---
# Specify the full path to the Mermaid CLI executable if it's not in the system's PATH
# MERMAID_CLI_PATH=/path/to/your/mmdc

MAX_WORKERS=4